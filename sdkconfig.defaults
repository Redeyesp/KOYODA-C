CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Custom partition layout (factory app at 0x10000). Without these the
# build silently falls back to the default 2-partition layout and
# partitions.csv is ignored entirely.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Keep LCD SPI queue shallow so PSRAM-backed LVGL flushes do not exhaust
# temporary DMA-capable internal buffers when Wi-Fi/APSTA is active.
CONFIG_BSP_LCD_TRANS_QUEUE_DEPTH=2

# --- Xiaozhi backend foundation ---
# TLS certificate bundle so the OTA check-in (HTTPS) and the WebSocket
# audio channel (WSS) can verify the server certificate.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# CRITICAL for this board: without these, mbedtls allocates its TLS
# buffers (tens of KB) from internal RAM -- the same pool the LCD needs
# for DMA flush buffers. The symptom is
#   "setup_dma_priv_buffer: Failed to allocate priv TX buffer"
#   "Draw bitmap failed: ESP_ERR_NO_MEM"
# and a ghosting/torn face the moment AI mode opens an HTTPS connection.
# EXTERNAL_MEM_ALLOC pushes mbedtls onto PSRAM; DYNAMIC_BUFFER frees the
# handshake buffers once the session is idle. Same settings xiaozhi-esp32
# ships for the ESP32-S3.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
